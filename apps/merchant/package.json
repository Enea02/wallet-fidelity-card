{
  "name": "@loyalty/merchant",
  "version": "0.1.0",
  "private": true,
  "description": "App esercente Expo (iOS, Android, Web) per titolare e staff.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node scripts/copy-zxing.mjs && expo start --web --port 8081",
    "start": "node scripts/copy-zxing.mjs && expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "node scripts/copy-zxing.mjs && expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && jest",
    "e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "sourcemaps:web": "node scripts/copy-zxing.mjs && expo export --platform web --output-dir dist --source-maps && sentry-cli sourcemaps upload dist"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@loyalty/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.117.3",
    "barcode-detector": "^3.2.2",
    "expo": "~57.0.28",
    "expo-application": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "~1.64.0",
    "@sentry/cli": "2.58.4",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "jest": "^30.5.2",
    "jest-expo": "^57.0.6",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
