{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "APP_BUILD": "dev", "SENTRY_DISABLE_AUTO_UPLOAD": "true" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "APP_BUILD": "preview" }
    },
    "production": {
      "autoIncrement": false
    }
  },
  "submit": { "production": {} }
}
