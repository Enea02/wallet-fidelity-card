# App esercente (Expo). In locale `pnpm db:start` crea .env.local con i valori del Supabase locale.
# Tutte le variabili EXPO_PUBLIC_* finiscono nel bundle dell'app: SOLO valori pubblici, mai segreti.

# URL del backend (apps/web). Sull'emulatore Android localhost viene sostituito da 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Supabase: URL e chiave anon (pubblica per definizione), usati solo per login e password.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Indirizzo della web app esercente: destinazione dei link "Password dimenticata?".
EXPO_PUBLIC_WEB_URL=http://localhost:8081
# development | test | production ("production" nasconde gli strumenti di prova del profilo).
EXPO_PUBLIC_APP_ENV=development

# --- Sentry (da completare con l'account Sentry) ---------------------------------
# DSN del progetto (pubblico: identifica solo dove mandare gli errori). Vuoto = Sentry spento.
EXPO_PUBLIC_SENTRY_DSN=
# Solo per caricare source map e simboli (EAS secret / GitHub secret, MAI nell'app):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# --- EAS (da completare con l'account Expo) --------------------------------------
# Id del progetto EAS (eas init lo stampa). Serve solo per le build nel cloud.
# EAS_PROJECT_ID=
