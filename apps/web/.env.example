# =============================================================
# apps/web — variabili d'ambiente
# In locale: `pnpm dev` crea apps/web/.env.local da questo file e lo compila
# con le chiavi del Supabase locale. In deploy: impostarle nell'hosting.
# Validate all'avvio (apps/web/src/lib/server-env.ts): se ne manca una
# obbligatoria il server non parte e il log dice quale e perché.
# Mai committare valori reali: questo file contiene solo segnaposto.
# =============================================================

# --- Generali ------------------------------------------------
# Ambiente: development | test | production (facoltativa, default development)
APP_ENV=development
# Livello minimo dei log: trace | debug | info | warn | error (facoltativa, default info)
LOG_LEVEL=info
# Formato dei log: json | pretty (facoltativa; default json in produzione, pretty in sviluppo)
LOG_FORMAT=
# Destinazione dei log: stdout | none (facoltativa, default stdout). In produzione Vercel
# inoltra stdout ad Axiom tramite Log Drain (configurato nel progetto Vercel, non qui).
LOG_TRANSPORT=stdout
# Salt per salvare gli IP solo come hash (OBBLIGATORIA, SEGRETA, almeno 16 caratteri).
# Generarlo con: openssl rand -hex 16. Cambiarlo rende non confrontabili gli hash vecchi.
IP_HASH_SALT=
# URL pubblico del sito, senza "/" finale (OBBLIGATORIA). Usato per QR del bancone e origin di Google Wallet.
APP_BASE_URL=http://localhost:3000

# --- Supabase ------------------------------------------------
# In locale li stampa `supabase status`. In remoto: Project Settings → API.
# URL del progetto (OBBLIGATORIA)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chiave pubblica anon (OBBLIGATORIA). Pubblica per definizione: usata dal login staff nel browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chiave service role (OBBLIGATORIA, SEGRETA). Solo lato server: bypassa la RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- App esercente ------------------------------------------
# Origini della web app esercente ammesse da CORS (OBBLIGATORIA), separate da virgola, senza "/" finale.
# In locale la web app Expo gira su http://localhost:8081.
MERCHANT_APP_ORIGINS=http://localhost:8081
# URL della web app esercente: i link delle email d'invito portano qui (facoltativa, default APP_BASE_URL)
MERCHANT_APP_URL=http://localhost:8081
# Rate limit delle API esercente, richieste al minuto (facoltative, default 120 per utente e 300 per IP)
RATE_LIMIT_USER_PER_MIN=120
RATE_LIMIT_IP_PER_MIN=300

# --- Cron e promozioni ---------------------------------------
# Segreto con cui pg_cron (Supabase) chiama /api/internal/cron/wallet-sync ogni minuto (OBBLIGATORIA, SEGRETA).
# Deve coincidere con quello nel Vault di Supabase: in locale lo imposta `pnpm db:start`,
# in produzione `pnpm cron:configure --url https://<dominio>/api/internal/cron/wallet-sync`.
CRON_SECRET=
# Firma dei link di disiscrizione nelle promozioni (OBBLIGATORIA, SEGRETA, almeno 32 caratteri).
# Cambiarlo invalida i link già inviati.
UNSUBSCRIBE_SECRET=
# Logo PNG pubblico per i negozi senza logo (facoltativa). Google lo scarica: in locale
# un indirizzo localhost non è raggiungibile da Google, usare un URL pubblico.
CARD_DEFAULT_LOGO_URL=

# --- Iscrizione con SMS (Twilio Verify) ----------------------
# test = codice 123456 senza SMS (sviluppo e test); twilio = SMS veri. In produzione solo twilio.
OTP_PROVIDER=test
# Da completare con l'account Twilio (console Twilio → Account Info; Verify → Services):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Limiti degli SMS (facoltative): per numero 3/ora e 5/giorno, per IP 10/ora
OTP_LIMIT_PER_NUMBER_HOUR=3
OTP_LIMIT_PER_NUMBER_DAY=5
OTP_LIMIT_PER_IP_HOUR=10

# --- Anti-bot (Cloudflare Turnstile) -------------------------
# OBBLIGATORIE. In locale `pnpm dev` mette le chiavi di prova pubbliche di Cloudflare (sempre valide);
# per la produzione crearle su dash.cloudflare.com → Turnstile (widget "Managed").
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Link pubblici -------------------------------------------
# Firma dei link brevi per aprire la carta dal telefono (OBBLIGATORIA, SEGRETA, almeno 32 caratteri).
PUBLIC_LINK_SECRET=

# --- Informativa privacy: responsabile del trattamento (noi) --
# Facoltative finché non ci sono: l'informativa mostra "[da completare]". Il testo va rivisto da un legale.
PROCESSOR_NAME=
PROCESSOR_ADDRESS=
PROCESSOR_VAT=
PROCESSOR_EMAIL=

# --- Amministrazione -----------------------------------------
# Token per POST /api/admin/setup-class (OBBLIGATORIA, SEGRETA, almeno 24 caratteri).
# Generarlo con: openssl rand -hex 24
ADMIN_SETUP_TOKEN=

# --- Google Wallet (facoltative: vuote = Google Wallet disattivato) ---
# Vanno impostate entrambe o nessuna. Procedura nel README, sezione "Google Wallet".
# Issuer ID dalla Google Pay & Wallet Console (solo cifre)
GOOGLE_WALLET_ISSUER_ID=
# Chiave JSON del service account in base64, su una riga (SEGRETA): base64 -i chiave.json | tr -d '\n'
GOOGLE_WALLET_SA_KEY_B64=

# --- Apple Wallet (facoltative, attivate in Fase 12) ----------
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
