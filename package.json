{
  "name": "loyalty-wallet",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm db:start && turbo run dev --filter=@loyalty/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:smoke": "pnpm --filter @loyalty/web test:smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "node scripts/db-start.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:new": "supabase migration new",
    "diag": "pnpm --filter @loyalty/web diag",
    "runbook": "tsx packages/shared/scripts/gen-runbook.ts",
    "runbook:check": "tsx packages/shared/scripts/gen-runbook.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.0",
    "tsx": "^4.23.0",
    "turbo": "^2.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
